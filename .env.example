# SPHEREx Explorer configuration. Every value is optional; the defaults are the public services
# verified in docs/research/spherex-data-research.md. Copy to backend/.env to override.
# No API keys or credentials are needed.

# Upstream services
# SPHEREX_SIA_URL=https://irsa.ipac.caltech.edu/SIA
# SPHEREX_S3_URL=https://nasa-irsa-spherex.s3.us-east-1.amazonaws.com/
# SPHEREX_IRSA_DATA_URL=https://irsa.ipac.caltech.edu/ibe/data/spherex/
# SPHEREX_SESAME_URL=https://cds.unistra.fr/cgi-bin/nph-sesame/-oxp/SNV
# SPHEREX_SBIDENT_URL=https://ssd-api.jpl.nasa.gov/sb_ident.api
# SPHEREX_HORIZONS_URL=https://ssd.jpl.nasa.gov/api/horizons.api

# Archive collections to search (JSON lists)
# SPHEREX_WIDE_COLLECTIONS=["spherex_qr2","spherex_qr3"]
# SPHEREX_DEEP_COLLECTIONS=["spherex_qr2_deep","spherex_qr3_deep"]

# Where fetched data is cached (default backend/.cache)
# SPHEREX_CACHE_DIR=/var/cache/spherex-explorer

# Limits
# SPHEREX_UPSTREAM_TIMEOUT_S=60
# SPHEREX_JPL_TIMEOUT_S=150
# SPHEREX_S3_CONCURRENCY=8
# SPHEREX_MAX_CUTOUT_DEG=0.5
# SPHEREX_RATE_LIMIT_PER_MINUTE=240

# Extra browser origins allowed to call the API directly (JSON list). Not needed for the bundled app.
# SPHEREX_CORS_ORIGINS=["https://example.org"]

# The assistant (the Ask panel): a language model on this machine phrases evidence the server
# gathers itself. "ollama" (default) uses Ollama's API; "openai" any OpenAI-compatible local server
# (LM Studio, llama.cpp's llama-server, mlx_lm.server); "off" answers from the app's own data only.
# When the model is not running, the assistant falls back to those built-in answers by itself.
# SPHEREX_ASSISTANT_PROVIDER=ollama
# SPHEREX_ASSISTANT_URL=http://127.0.0.1:11434
# SPHEREX_ASSISTANT_MODEL=qwen3:4b-instruct-2507-q4_K_M
# SPHEREX_ASSISTANT_MAX_TOKENS=600
# SPHEREX_ASSISTANT_CONTEXT_TOKENS=8192
# SPHEREX_ASSISTANT_TEMPERATURE=0.2
# SPHEREX_ASSISTANT_KEEP_ALIVE=10m
# SPHEREX_ASSISTANT_TIMEOUT_S=120
